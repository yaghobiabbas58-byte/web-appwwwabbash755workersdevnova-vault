{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appwwwabbash755workersdevnova-vault",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "d04c2a40-a438-46b9-aa44-6163ae9473f4","database_name": "wwwabbash755gmailcomnova-db" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "fbadbae1e8d1409682ca4c747c01c7af" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
